{
  "name": "calino",
  "private": true,
  "version": "0.38.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/update-sample-events.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "check:docker": "pnpm check && docker build -t calino:test . && docker run --rm -d --name calino-test -p 8080:8080 calino:test && sleep 3 && curl -sf http://localhost:8080/ > /dev/null && echo '✅ Docker build and healthcheck passed' && docker stop calino-test || (docker stop calino-test 2>/dev/null; echo '❌ Docker check failed'; exit 1)"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.5",
    "@capacitor/filesystem": "^8.1.4",
    "@capgo/capacitor-share-target": "^8.0.54",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@touch4it/ical-timezones": "^1.9.0",
    "@use-gesture/react": "^10.3.1",
    "browser-image-compression": "^2.0.2",
    "chrono-node": "^2.10.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.6",
    "framer-motion": "^13.1.1",
    "fuse.js": "^7.5.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.51.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.8",
    "tsdav": "^2.3.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^4.1.0",
      "picomatch": "^4.0.5",
      "brace-expansion": "^5.0.8"
    }
  }
}
