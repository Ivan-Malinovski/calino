:8080 {
	request_body {
		max_size 1mb
	}

	encode gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, immutable"

	@sw path /sw.js
	header @sw Cache-Control "no-store, no-cache, must-revalidate"
	header @sw Service-Worker-Allowed "/"

	# Keep the mounted directory outside the SPA document root.
	handle /calino.config.json {
		header Cache-Control "no-store"
		@protected expression `{env.CALINO_CONFIG_AUTH_USER} != "" && {env.CALINO_CONFIG_AUTH_HASH} != ""`
		@public expression `{env.CALINO_CONFIG_ALLOW_PUBLIC} == "true" && {env.CALINO_CONFIG_AUTH_USER} == "" && {env.CALINO_CONFIG_AUTH_HASH} == ""`
		@anonymousAppFetch {
			header X-Calino-Config-Fetch 1
			not header Authorization *
		}
		@missingConfig not file /calino.config.json

		handle @protected {
			route {
				root * /calino
				respond @missingConfig 404
				# Tell the app to show its own sign-in form without a native challenge.
				header @anonymousAppFetch X-Calino-Config-Auth basic
				respond @anonymousAppFetch 401
				basic_auth {
					# Caddy validates this block even when @protected is false.
					{$CALINO_CONFIG_AUTH_USER:disabled} {$CALINO_CONFIG_AUTH_HASH:AA==}
				}
				file_server
			}
		}

		handle @public {
			root * /calino
			file_server
		}

		# Also deny access if only one authentication setting was supplied.
		handle {
			respond 404
		}
	}

	handle_errors 401 {
		@configAppFetch {
			path /calino.config.json
			header X-Calino-Config-Fetch 1
		}
		handle @configAppFetch {
			header -WWW-Authenticate
			header Cache-Control "no-store"
			header X-Calino-Config-Auth basic
			respond 401
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
